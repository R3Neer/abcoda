{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "exactOptionalPropertyTypes": false,
    "rootDir": ".",
    "outDir": "dist/server",
    "noEmit": false
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"]
}
