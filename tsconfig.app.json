{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/widget/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/worker/**/*.ts",
    "tests/browser/**/*.ts",
    "playwright.config.ts"
  ]
}
