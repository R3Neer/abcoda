{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "abcoda",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../dist/v2-widget",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://chatgpt.com,https://chat.openai.com,http://localhost:5173,http://127.0.0.1:5173"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
